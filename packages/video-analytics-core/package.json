{
  "name": "@imagekit/video-analytics-core",
  "version": "0.1.0",
  "private": true,
  "description": "Player-agnostic ImageKit video analytics core: session/view state machine, v1 wire format, batching and beacon transport.",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node test/run.mjs"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "~5.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imagekit-developer/imagekit-video-player.git"
  }
}
